mdl 1.8;

import ::df::*;
import ::base::*;
import ::math::*;
import ::state::*;
import ::anno::*;
import ::tex::*;
using ::materialx::core import *;
using ::materialx::sampling import *;
using ::materialx::stdlib_1_8 import *;
using ::materialx::pbrlib_1_8 import *;

color NG_convert_float_color3
(
    float in1 = 0.000000
)
{
    color combine_out = color( in1,in1,in1 );
    return combine_out;
}

export material NG_standard_surface_surfaceshader_100_out
(
    float base = 0.800000
    [[
    	materialx::core::origin("")
    ]],
    color base_color = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    float diffuse_roughness = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float metalness = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float specular = 1.000000
    [[
    	materialx::core::origin("")
    ]],
    color specular_color = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    float specular_roughness = 0.200000
    [[
    	materialx::core::origin("")
    ]],
    uniform float specular_IOR = 1.500000
    [[
    	materialx::core::origin("")
    ]],
    float specular_anisotropy = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float specular_rotation = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float transmission = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    color transmission_color = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    float transmission_extra_roughness = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float subsurface = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    color subsurface_color = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    color subsurface_radius = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    float subsurface_scale = 1.000000
    [[
    	materialx::core::origin("")
    ]],
    float subsurface_anisotropy = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float sheen = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    color sheen_color = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    float sheen_roughness = 0.300000
    [[
    	materialx::core::origin("")
    ]],
    float coat = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    color coat_color = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    float coat_roughness = 0.100000
    [[
    	materialx::core::origin("")
    ]],
    float coat_anisotropy = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float coat_rotation = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    uniform float coat_IOR = 1.500000
    [[
    	materialx::core::origin("")
    ]],
    float3 coat_normal = state::transform_normal(state::coordinate_internal, state::coordinate_world, state::normal())
    [[
    	materialx::core::origin("")
    ]],
    float coat_affect_color = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float coat_affect_roughness = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float thin_film_thickness = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    float thin_film_IOR = 1.500000
    [[
    	materialx::core::origin("")
    ]],
    float emission = 0.000000
    [[
    	materialx::core::origin("")
    ]],
    color emission_color = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    color opacity = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("")
    ]],
    bool thin_walled = false
    [[
    	materialx::core::origin("")
    ]],
    float3 normal = state::transform_normal(state::coordinate_internal, state::coordinate_world, state::normal())
    [[
    	materialx::core::origin("")
    ]],
    float3 tangent = state::transform_vector(state::coordinate_internal, state::coordinate_world, state::texture_tangent_u(0))
    [[
    	materialx::core::origin("")
    ]],
    float coat_tangent_rotate_degree_in2 = 360.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_tangent_rotate_degree/in2")
    ]],
    float tangent_rotate_degree_in2 = 360.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/tangent_rotate_degree/in2")
    ]],
    uniform string sheen_bsdf_mode = "conty_kulla"
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/sheen_bsdf/mode")
    ]],
    float subsurface_color_nonnegative_in2 = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/subsurface_color_nonnegative/in2")
    ]],
    float coat_clamped_low = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_clamped/low")
    ]],
    float coat_clamped_high = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_clamped/high")
    ]],
    float base_color_nonnegative_in2 = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/base_color_nonnegative/in2")
    ]],
    color coat_attenuation_bg = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_attenuation/bg")
    ]],
    float one_minus_coat_ior_in1 = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/one_minus_coat_ior/in1")
    ]],
    float one_plus_coat_ior_in1 = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/one_plus_coat_ior/in1")
    ]],
    color opacity_luminance_lumacoeffs = color(0.272229, 0.674082, 0.053689)
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/opacity_luminance/lumacoeffs")
    ]],
    float transmission_roughness_clamped_low = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/transmission_roughness_clamped/low")
    ]],
    float transmission_roughness_clamped_high = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/transmission_roughness_clamped/high")
    ]],
    uniform int opacity_luminance_float_index = 0
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/opacity_luminance_float/index")
    ]],
    float coat_affected_roughness_fg = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_affected_roughness/fg")
    ]],
    float coat_affected_transmission_roughness_fg = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_affected_transmission_roughness/fg")
    ]],
    float coat_gamma_in2 = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_gamma/in2")
    ]],
    float coat_tangent_value2 = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_tangent/value2")
    ]],
    float main_tangent_value2 = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/main_tangent/value2")
    ]],
    float one_minus_coat_ior_to_F0_in1 = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/one_minus_coat_ior_to_F0/in1")
    ]],
    color coat_bsdf_tint = color(1.000000, 1.000000, 1.000000)
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_bsdf/tint")
    ]],
    float coat_bsdf_thinfilm_thickness = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_bsdf/thinfilm_thickness")
    ]],
    float coat_bsdf_thinfilm_ior = 1.500000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_bsdf/thinfilm_ior")
    ]],
    uniform mx_distribution_type coat_bsdf_distribution = mx_distribution_type_ggx
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_bsdf/distribution")
    ]],
    uniform mx_scatter_mode coat_bsdf_scatter_mode = mx_scatter_mode_R
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_bsdf/scatter_mode")
    ]],
    float metal_bsdf_weight = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/metal_bsdf/weight")
    ]],
    uniform mx_distribution_type metal_bsdf_distribution = mx_distribution_type_ggx
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/metal_bsdf/distribution")
    ]],
    uniform mx_distribution_type specular_bsdf_distribution = mx_distribution_type_ggx
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/specular_bsdf/distribution")
    ]],
    uniform mx_scatter_mode specular_bsdf_scatter_mode = mx_scatter_mode_R
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/specular_bsdf/scatter_mode")
    ]],
    float transmission_bsdf_weight = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/transmission_bsdf/weight")
    ]],
    float transmission_bsdf_thinfilm_thickness = 0.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/transmission_bsdf/thinfilm_thickness")
    ]],
    float transmission_bsdf_thinfilm_ior = 1.500000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/transmission_bsdf/thinfilm_ior")
    ]],
    uniform mx_distribution_type transmission_bsdf_distribution = mx_distribution_type_ggx
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/transmission_bsdf/distribution")
    ]],
    uniform mx_scatter_mode transmission_bsdf_scatter_mode = mx_scatter_mode_T
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/transmission_bsdf/scatter_mode")
    ]],
    float translucent_bsdf_weight = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/translucent_bsdf/weight")
    ]],
    float subsurface_bsdf_weight = 1.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/subsurface_bsdf/weight")
    ]],
    uniform bool diffuse_bsdf_energy_compensation = false
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/diffuse_bsdf/energy_compensation")
    ]],
    color coat_emission_edf_color90 = color(0.000000, 0.000000, 0.000000)
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_emission_edf/color90")
    ]],
    float coat_emission_edf_exponent = 5.000000
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/coat_emission_edf/exponent")
    ]],
    uniform bool shader_constructor_thin_walled = false
    [[
    	materialx::core::origin("NG_standard_surface_surfaceshader_100/shader_constructor/thin_walled")
    ]]
)
= let
{
    float2 coat_roughness_vector_out = materialx::pbrlib_1_8::mx_roughness_anisotropy(mxp_roughness:coat_roughness, mxp_anisotropy:coat_anisotropy);
    float coat_tangent_rotate_degree_out = coat_rotation * coat_tangent_rotate_degree_in2;
    color metal_reflectivity_out = base_color * base;
    color metal_edgecolor_out = specular_color * specular;
    float coat_affect_roughness_multiply1_out = coat_affect_roughness * coat;
    float tangent_rotate_degree_out = specular_rotation * tangent_rotate_degree_in2;
    float transmission_roughness_add_out = specular_roughness + transmission_extra_roughness;
    color subsurface_color_nonnegative_out = math::max(subsurface_color, subsurface_color_nonnegative_in2);
    float coat_clamped_out = math::clamp(coat, coat_clamped_low, coat_clamped_high);
    color subsurface_radius_scaled_out = subsurface_radius * subsurface_scale;
    float subsurface_selector_out = float(thin_walled);
    color base_color_nonnegative_out = math::max(base_color, base_color_nonnegative_in2);
    color coat_attenuation_out = math::lerp(coat_attenuation_bg, coat_color, coat);
    float one_minus_coat_ior_out = one_minus_coat_ior_in1 - coat_IOR;
    float one_plus_coat_ior_out = one_plus_coat_ior_in1 + coat_IOR;
    color emission_weight_out = emission_color * emission;
    color opacity_luminance_out = materialx::stdlib_1_8::mx_luminance_color3(opacity);
    float3 coat_tangent_rotate_out = materialx::stdlib_1_8::mx_rotate3d_vector3(mxp_in:tangent, mxp_amount:coat_tangent_rotate_degree_out, mxp_axis:coat_normal);
    materialx::pbrlib_1_8::mx_artistic_ior__result artistic_ior_result = materialx::pbrlib_1_8::mx_artistic_ior(mxp_reflectivity:metal_reflectivity_out, mxp_edge_color:metal_edgecolor_out);
    float coat_affect_roughness_multiply2_out = coat_affect_roughness_multiply1_out * coat_roughness;
    float3 tangent_rotate_out = materialx::stdlib_1_8::mx_rotate3d_vector3(mxp_in:tangent, mxp_amount:tangent_rotate_degree_out, mxp_axis:normal);
    float transmission_roughness_clamped_out = math::clamp(transmission_roughness_add_out, transmission_roughness_clamped_low, transmission_roughness_clamped_high);
    float coat_gamma_multiply_out = coat_clamped_out * coat_affect_color;
    float coat_ior_to_F0_sqrt_out = one_minus_coat_ior_out / one_plus_coat_ior_out;
    float opacity_luminance_float_out = materialx::stdlib_1_8::mx_extract_color3(opacity_luminance_out, opacity_luminance_float_index);
    float3 coat_tangent_rotate_normalize_out = math::normalize(coat_tangent_rotate_out);
    float coat_affected_roughness_out = math::lerp(specular_roughness, coat_affected_roughness_fg, coat_affect_roughness_multiply2_out);
    float3 tangent_rotate_normalize_out = math::normalize(tangent_rotate_out);
    float coat_affected_transmission_roughness_out = math::lerp(transmission_roughness_clamped_out, coat_affected_transmission_roughness_fg, coat_affect_roughness_multiply2_out);
    float coat_gamma_out = coat_gamma_multiply_out + coat_gamma_in2;
    float coat_ior_to_F0_out = coat_ior_to_F0_sqrt_out * coat_ior_to_F0_sqrt_out;
    float3 coat_tangent_out = materialx::stdlib_1_8::mx_ifgreater_vector3(coat_anisotropy, coat_tangent_value2, coat_tangent_rotate_normalize_out, tangent);
    float2 main_roughness_out = materialx::pbrlib_1_8::mx_roughness_anisotropy(mxp_roughness:coat_affected_roughness_out, mxp_anisotropy:specular_anisotropy);
    float3 main_tangent_out = materialx::stdlib_1_8::mx_ifgreater_vector3(specular_anisotropy, main_tangent_value2, tangent_rotate_normalize_out, tangent);
    float2 transmission_roughness_out = materialx::pbrlib_1_8::mx_roughness_anisotropy(mxp_roughness:coat_affected_transmission_roughness_out, mxp_anisotropy:specular_anisotropy);
    color coat_affected_subsurface_color_out = math::pow(subsurface_color_nonnegative_out, coat_gamma_out);
    color coat_affected_diffuse_color_out = math::pow(base_color_nonnegative_out, coat_gamma_out);
    float one_minus_coat_ior_to_F0_out = one_minus_coat_ior_to_F0_in1 - coat_ior_to_F0_out;
    color emission_color0_out = NG_convert_float_color3(one_minus_coat_ior_to_F0_out);
    material metal_bsdf_out = materialx::pbrlib_1_8::mx_conductor_bsdf(mxp_weight:metal_bsdf_weight, mxp_ior:artistic_ior_result.mxp_ior, mxp_extinction:artistic_ior_result.mxp_extinction, mxp_roughness:main_roughness_out, mxp_thinfilm_thickness:thin_film_thickness, mxp_thinfilm_ior:thin_film_IOR, mxp_normal:normal, mxp_tangent:main_tangent_out, mxp_distribution:metal_bsdf_distribution);
    material transmission_bsdf_out = materialx::pbrlib_1_8::mx_dielectric_bsdf(mxp_weight:transmission_bsdf_weight, mxp_tint:transmission_color, mxp_ior:specular_IOR, mxp_roughness:transmission_roughness_out, mxp_thinfilm_thickness:transmission_bsdf_thinfilm_thickness, mxp_thinfilm_ior:transmission_bsdf_thinfilm_ior, mxp_normal:normal, mxp_tangent:main_tangent_out, mxp_distribution:transmission_bsdf_distribution, mxp_scatter_mode:transmission_bsdf_scatter_mode, mxp_base:material());
    material translucent_bsdf_out = materialx::pbrlib_1_8::mx_translucent_bsdf(mxp_weight:translucent_bsdf_weight, mxp_color:coat_affected_subsurface_color_out, mxp_normal:normal);
    material subsurface_bsdf_out = materialx::pbrlib_1_8::mx_subsurface_bsdf(mxp_weight:subsurface_bsdf_weight, mxp_color:coat_affected_subsurface_color_out, mxp_radius:subsurface_radius_scaled_out, mxp_anisotropy:subsurface_anisotropy, mxp_normal:normal);
    material selected_subsurface_bsdf_out = materialx::pbrlib_1_8::mx_mix_bsdf(mxp_fg:translucent_bsdf_out, mxp_bg:subsurface_bsdf_out, mxp_mix:subsurface_selector_out);
    material diffuse_bsdf_out = materialx::pbrlib_1_8::mx_oren_nayar_diffuse_bsdf(mxp_weight:base, mxp_color:coat_affected_diffuse_color_out, mxp_roughness:diffuse_roughness, mxp_normal:normal);
    material subsurface_mix_out = materialx::pbrlib_1_8::mx_mix_bsdf(mxp_fg:selected_subsurface_bsdf_out, mxp_bg:diffuse_bsdf_out, mxp_mix:subsurface);
    material sheen_layer_out = materialx::pbrlib_1_8::mx_sheen_bsdf(mxp_weight:sheen, mxp_color:sheen_color, mxp_roughness:sheen_roughness, mxp_normal:normal, mxp_base:subsurface_mix_out);
    material transmission_mix_out = materialx::pbrlib_1_8::mx_mix_bsdf(mxp_fg:transmission_bsdf_out, mxp_bg:sheen_layer_out, mxp_mix:transmission);
    material specular_layer_out = materialx::pbrlib_1_8::mx_dielectric_bsdf(mxp_weight:specular, mxp_tint:specular_color, mxp_ior:specular_IOR, mxp_roughness:main_roughness_out, mxp_thinfilm_thickness:thin_film_thickness, mxp_thinfilm_ior:thin_film_IOR, mxp_normal:normal, mxp_tangent:main_tangent_out, mxp_distribution:specular_bsdf_distribution, mxp_scatter_mode:specular_bsdf_scatter_mode, mxp_base:transmission_mix_out);
    material metalness_mix_out = materialx::pbrlib_1_8::mx_mix_bsdf(mxp_fg:metal_bsdf_out, mxp_bg:specular_layer_out, mxp_mix:metalness);
    material thin_film_layer_attenuated_out = materialx::pbrlib_1_8::mx_multiply_bsdf_color3(mxp_in1:metalness_mix_out, mxp_in2:coat_attenuation_out);
    material coat_layer_out = materialx::pbrlib_1_8::mx_dielectric_bsdf(mxp_weight:coat, mxp_tint:coat_bsdf_tint, mxp_ior:coat_IOR, mxp_roughness:coat_roughness_vector_out, mxp_thinfilm_thickness:coat_bsdf_thinfilm_thickness, mxp_thinfilm_ior:coat_bsdf_thinfilm_ior, mxp_normal:coat_normal, mxp_tangent:coat_tangent_out, mxp_distribution:coat_bsdf_distribution, mxp_scatter_mode:coat_bsdf_scatter_mode, mxp_base:thin_film_layer_attenuated_out);
    material emission_edf_out = materialx::pbrlib_1_8::mx_uniform_edf(mxp_color:emission_weight_out);
    material coat_tinted_emission_edf_out = materialx::pbrlib_1_8::mx_multiply_edf_color3(mxp_in1:emission_edf_out, mxp_in2:coat_color);
    material coat_emission_edf_out = materialx::pbrlib_1_8::mx_generalized_schlick_edf(mxp_color0:emission_color0_out, mxp_color90:coat_emission_edf_color90, mxp_exponent:coat_emission_edf_exponent, mxp_base:coat_tinted_emission_edf_out);
    material blended_coat_emission_edf_out = materialx::pbrlib_1_8::mx_mix_edf(mxp_fg:coat_emission_edf_out, mxp_bg:emission_edf_out, mxp_mix:coat);
    material shader_constructor_out = materialx::pbrlib_1_8::mx_surface(coat_layer_out, blended_coat_emission_edf_out, opacity_luminance_float_out, shader_constructor_thin_walled, specular_IOR);
    material finalOutput__ = shader_constructor_out;
}
in material(finalOutput__);
